        "file_suffix": "tests/fixtures/recompile/_generate.py"
      },
      "expected_suggestion_keywords": ["dtype", "cast"]
    },
    {
      "category": "stride",
      "guard_template_contains": ["stride", "contiguous"],
      "expected_attribution": {
        "function": "f",
        "file_suffix": "tests/fixtures/recompile/_generate.py"
      },
      "expected_suggestion_keywords": ["contiguous", ".contiguous()"]
    }
  ]
